# Copy to config.env and pass it to build-image.sh. Do not commit passwords.
# CLOCK_PASSWORD and CLOCK_WIFI_PSK are read from the environment or prompted.
# This file is sourced by bash.

# Raspberry Pi OS Lite 64-bit, Debian 13 Trixie, 2026-10-06.
# The script downloads the .sha256 next to the image and requires it to match
# PI_OS_SHA256, so a replaced file fails closed.
PI_OS_DATE=2026-10-06
PI_OS_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-10-06/2026-10-06-raspios-trixie-arm64-lite.img.xz
PI_OS_SHA256=483db18a48da399b5b7022ffae9a07bc6d99daab30e593aedac09b69ff422843

CLOCK_HOSTNAME=clock
CLOCK_USER=clock
# 1 enables sshd and password login. 0 leaves sshd disabled.
CLOCK_SSH=1
# Optional path to a file of public keys (one per line). Empty skips keys.
CLOCK_SSH_AUTHORIZED_KEYS=

# Empty SSID leaves Wi-Fi unconfigured (Ethernet still comes up).
CLOCK_WIFI_SSID=
CLOCK_WIFI_COUNTRY=US
CLOCK_WIFI_HIDDEN=0

CLOCK_TIMEZONE=America/Indiana/Indianapolis
CLOCK_LOCALE=en_US.UTF-8
CLOCK_KEYBOARD=us

# Clockwise degrees. 90 matches the Dell panel turned clockwise into portrait.
CLOCK_ROTATION=90
# kms: clockface on tty1, kernel rotate. labwc: plain labwc, wlr-randr instead.
CLOCK_KIOSK=kms
# "analog" picks the headphone jack. Or set a PipeWire sink name.
CLOCK_AUDIO_SINK=analog

# Empty builds the clockface checkout you have. A branch, tag, or SHA is
# fetched into a temporary worktree and built from there.
CLOCKFACE_REF=

# Local IndianaDell checkout or a directory with wizard.png, if the raw
# download is unreachable. The PNGs are not committed (IndianaDell has no license).
WIZARD_SRC=
